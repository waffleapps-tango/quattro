// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  published Boolean? @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum Role {
  RESIDENT
  RECEPTIONIST
  MANAGER
  ADMIN
}

enum PackageStatus {
  RECEIVED
  READY_FOR_PICKUP
  PICKED_UP
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  firstName   String?
  lastName    String?
  locale      String?
  shareName   Boolean  @default(true)
  createdAt   DateTime @default(now())

  memberships       Membership[]
  residencies       ApartmentResidency[]
  recipientPackages Package[]            @relation("PackageRecipient")
  receivedPackages  Package[]            @relation("PackageReceivedBy")
  pickedUpPackages  Package[]            @relation("PackagePickedUpBy")
  auditLogs         AuditLog[]
  reports           Report[]
  notifications     Notification[]       @relation("NotificationRecipient")
}

model Community {
  id                String   @id @default(cuid())
  name              String
  address           String?
  reminderAfterDays Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  buildings     Building[]
  memberships   Membership[]
  residencies   ApartmentResidency[]
  packages      Package[]
  auditLogs     AuditLog[]
  parkingSpaces ParkingSpace[]
  storageUnits  StorageUnit[]
  reports       Report[]
  notifications Notification[]
  infoSections  InfoSection[]
}

model Building {
  id          String   @id @default(cuid())
  communityId String
  name        String
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community     Community      @relation(fields: [communityId], references: [id])
  apartments    Apartment[]
  memberships   Membership[]
  packages      Package[]
  parkingSpaces ParkingSpace[]
  storageUnits  StorageUnit[]
  reports       Report[]

  @@index([communityId])
}

model Apartment {
  id         String   @id @default(cuid())
  buildingId String
  number     String
  floor      Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building      Building             @relation(fields: [buildingId], references: [id])
  memberships   Membership[]
  residencies   ApartmentResidency[]
  packages      Package[]
  parkingSpaces ParkingSpace[]
  storageUnits  StorageUnit[]
  reports       Report[]

  @@unique([buildingId, number])
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  communityId String
  buildingId  String?
  // DEPRECATED: apartment links live in ApartmentResidency. Not read or written by the app.
  apartmentId String?
  role        Role
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id])
  community Community  @relation(fields: [communityId], references: [id])
  building  Building?  @relation(fields: [buildingId], references: [id])
  apartment Apartment? @relation(fields: [apartmentId], references: [id])

  @@unique([userId, communityId])
  @@index([communityId])
  @@index([userId])
}

model Package {
  id              String  @id @default(cuid())
  communityId     String
  buildingId      String
  apartmentId     String
  recipientUserId String?

  trackingNumber String?
  courier        String?
  status         PackageStatus @default(RECEIVED)

  receivedAt   DateTime  @default(now())
  receivedById String
  pickedUpAt   DateTime?
  pickedUpById String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  community  Community @relation(fields: [communityId], references: [id])
  building   Building  @relation(fields: [buildingId], references: [id])
  apartment  Apartment @relation(fields: [apartmentId], references: [id])
  recipient  User?     @relation("PackageRecipient", fields: [recipientUserId], references: [id])
  receivedBy User      @relation("PackageReceivedBy", fields: [receivedById], references: [id])
  pickedUpBy User?     @relation("PackagePickedUpBy", fields: [pickedUpById], references: [id])

  @@index([communityId, status])
  @@index([apartmentId])
  @@index([trackingNumber])
}

enum ReportType {
  DEFECT
  REQUEST
  NOTICE
  QUESTION
  IDEA
  COMPLAINT
}

enum ReportVisibility {
  PUBLIC
  PRIVATE
}

enum ReportStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  APPROVED
  REJECTED
  CLOSED
}

model ParkingSpace {
  id           String   @id @default(cuid())
  communityId  String
  buildingId   String?
  apartmentId  String?
  number       String
  level        String?
  hasEvCharger Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  community Community  @relation(fields: [communityId], references: [id])
  building  Building?  @relation(fields: [buildingId], references: [id])
  apartment Apartment? @relation(fields: [apartmentId], references: [id])
  reports   Report[]

  @@unique([communityId, number])
  @@index([apartmentId])
}

model StorageUnit {
  id          String   @id @default(cuid())
  communityId String
  buildingId  String
  apartmentId String?
  number      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community  @relation(fields: [communityId], references: [id])
  building  Building   @relation(fields: [buildingId], references: [id])
  apartment Apartment? @relation(fields: [apartmentId], references: [id])
  reports   Report[]

  @@unique([buildingId, number])
  @@index([apartmentId])
}

model Report {
  id             String           @id @default(cuid())
  communityId    String
  buildingId     String?
  apartmentId    String?
  parkingSpaceId String?
  storageUnitId  String?
  authorId       String
  category       String
  type           ReportType
  visibility     ReportVisibility
  title          String
  description    String
  status         ReportStatus     @default(NEW)
  urgent         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  resolvedAt     DateTime?

  community    Community     @relation(fields: [communityId], references: [id])
  building     Building?     @relation(fields: [buildingId], references: [id])
  apartment    Apartment?    @relation(fields: [apartmentId], references: [id])
  parkingSpace ParkingSpace? @relation(fields: [parkingSpaceId], references: [id])
  storageUnit  StorageUnit?  @relation(fields: [storageUnitId], references: [id])
  author       User          @relation(fields: [authorId], references: [id])

  @@index([communityId, visibility, status])
  @@index([authorId])
}

model AuditLog {
  id          String   @id @default(cuid())
  communityId String
  userId      String?
  action      String
  entity      String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([communityId, createdAt])
  @@index([entity, entityId])
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id              String    @id @default(cuid())
  communityId     String
  recipientUserId String
  type            String
  payload         Json
  dedupeKey       String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  community  Community              @relation(fields: [communityId], references: [id])
  recipient  User                   @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  deliveries NotificationDelivery[]

  @@unique([recipientUserId, dedupeKey])
  @@index([recipientUserId, readAt, createdAt])
  @@index([communityId])
}

model NotificationDelivery {
  id             String         @id @default(cuid())
  notificationId String
  channel        String
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  lastError      String?
  sentAt         DateTime?
  nextAttemptAt  DateTime?
  createdAt      DateTime       @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
}

enum ResidencyKind {
  OWNER
  TENANT
}

model ApartmentResidency {
  id                String        @id @default(cuid())
  userId            String
  apartmentId       String
  communityId       String
  kind              ResidencyKind
  livesHereOverride Boolean?
  receivesPackages  Boolean       @default(true)
  isPrimary         Boolean       @default(false)
  createdAt         DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id])
  apartment Apartment @relation(fields: [apartmentId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([userId, apartmentId])
  @@index([userId])
  @@index([apartmentId])
}

enum InfoSectionKind {
  CONTACTS
  TEXT
}

model InfoSection {
  id          String          @id @default(cuid())
  communityId String
  title       String
  kind        InfoSectionKind
  body        String          @default("")
  position    Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  community Community     @relation(fields: [communityId], references: [id])
  contacts  InfoContact[]

  @@index([communityId, position])
}

model InfoContact {
  id        String  @id @default(cuid())
  sectionId String
  name      String
  phone     String
  note      String?
  position  Int

  section InfoSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
}
