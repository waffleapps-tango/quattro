# Postgres connection string. Local dev: see docker-compose.yml (docker compose up -d postgres)
DATABASE_URL="postgresql://quattro:quattro@localhost:5432/quattro"

# Clerk — https://dashboard.clerk.com, create an application with Google OAuth enabled
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Shared secret for the Vercel cron route (set the same value in Vercel project env vars)
CRON_SECRET=

# Email via Resend (https://resend.com). EMAIL_FROM must be a verified sender, e.g. "Quattro <noreply@yourdomain.pl>"
RESEND_API_KEY=
EMAIL_FROM=
# Public base URL of the app; used for the settings link in emails
APP_URL=
