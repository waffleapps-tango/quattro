{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quattro-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "quattro-dev-gcp",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "dotenv",
        "-e",
        ".env.gcp",
        "-v",
        "NEXT_PUBLIC_E2E_IMPERSONATE=1",
        "--",
        "next",
        "dev"
      ],
      "port": 3000
    }
  ]
}
