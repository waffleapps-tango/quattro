// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostKind {
  ANNOUNCEMENT
  NEIGHBOR
}

model Post {
  id          String    @id @default(cuid())
  communityId String
  authorId    String?
  kind        PostKind  @default(ANNOUNCEMENT)
  title       String
  slug        String    @unique
  content     String
  published   Boolean?  @default(false)
  pinnedUntil DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id])
  author    User?     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  reactions Reaction[]
  comments  Comment[]

  @@index([communityId, kind, createdAt])
}

enum Role {
  RESIDENT
  RECEPTIONIST
  MANAGER
  ADMIN
}

enum PackageStatus {
  RECEIVED
  READY_FOR_PICKUP
  PICKED_UP
}

model User {
  posts       Post[]   @relation("PostAuthor")
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  firstName   String?
  lastName    String?
  locale      String?
  shareName   Boolean  @default(true)
  createdAt   DateTime @default(now())

  memberships            Membership[]
  residencies            ApartmentResidency[]
  recipientPackages      Package[]               @relation("PackageRecipient")
  receivedPackages       Package[]               @relation("PackageReceivedBy")
  pickedUpPackages       Package[]               @relation("PackagePickedUpBy")
  auditLogs              AuditLog[]
  reports                Report[]
  notifications          Notification[]          @relation("NotificationRecipient")
  notificationPreference NotificationPreference?
  reactions              Reaction[]
  comments               Comment[]
  joinRequests           JoinRequest[]           @relation("JoinRequestUser")
  decidedJoinRequests    JoinRequest[]           @relation("JoinRequestDecidedBy")
}

model Community {
  posts                           Post[]
  id                              String   @id @default(cuid())
  name                            String
  address                         String?
  reminderAfterDays               Int?
  receptionCanApproveJoinRequests Boolean  @default(false)
  receptionCanInvite              Boolean  @default(false)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  buildings     Building[]
  memberships   Membership[]
  residencies   ApartmentResidency[]
  packages      Package[]
  auditLogs     AuditLog[]
  parkingSpaces ParkingSpace[]
  storageUnits  StorageUnit[]
  reports       Report[]
  notifications Notification[]
  infoSections  InfoSection[]
  joinRequests  JoinRequest[]
}

model Building {
  id          String   @id @default(cuid())
  communityId String
  name        String
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community     Community      @relation(fields: [communityId], references: [id])
  apartments    Apartment[]
  memberships   Membership[]
  packages      Package[]
  parkingSpaces ParkingSpace[]
  storageUnits  StorageUnit[]
  reports       Report[]
  joinRequests  JoinRequest[]

  @@index([communityId])
}

model Apartment {
  id         String   @id @default(cuid())
  buildingId String
  number     String
  floor      Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building      Building             @relation(fields: [buildingId], references: [id])
  memberships   Membership[]
  residencies   ApartmentResidency[]
  packages      Package[]
  parkingSpaces ParkingSpace[]
  storageUnits  StorageUnit[]
  reports       Report[]
  joinRequests  JoinRequest[]

  @@unique([buildingId, number])
}

model Membership {
  id           String    @id @default(cuid())
  userId       String
  communityId  String
  buildingId   String?
  // DEPRECATED: apartment links live in ApartmentResidency. Not read or written by the app.
  apartmentId  String?
  role         Role
  inviteSentAt DateTime?
  createdAt    DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id])
  community Community  @relation(fields: [communityId], references: [id])
  building  Building?  @relation(fields: [buildingId], references: [id])
  apartment Apartment? @relation(fields: [apartmentId], references: [id])

  @@unique([userId, communityId])
  @@index([communityId])
  @@index([userId])
}

model Package {
  id              String  @id @default(cuid())
  communityId     String
  buildingId      String
  apartmentId     String
  recipientUserId String?

  trackingNumber String?
  courier        String?
  status         PackageStatus @default(RECEIVED)

  receivedAt   DateTime  @default(now())
  receivedById String
  pickedUpAt   DateTime?
  pickedUpById String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  community  Community @relation(fields: [communityId], references: [id])
  building   Building  @relation(fields: [buildingId], references: [id])
  apartment  Apartment @relation(fields: [apartmentId], references: [id])
  recipient  User?     @relation("PackageRecipient", fields: [recipientUserId], references: [id])
  receivedBy User      @relation("PackageReceivedBy", fields: [receivedById], references: [id])
  pickedUpBy User?     @relation("PackagePickedUpBy", fields: [pickedUpById], references: [id])

  @@index([communityId, status])
  @@index([apartmentId])
  @@index([trackingNumber])
}

enum ReportType {
  DEFECT
  REQUEST
  NOTICE
  QUESTION
  IDEA
  COMPLAINT
}

enum ReportVisibility {
  PUBLIC
  PRIVATE
}

enum ReportStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  APPROVED
  REJECTED
  CLOSED
}

model ParkingSpace {
  id           String   @id @default(cuid())
  communityId  String
  buildingId   String?
  apartmentId  String?
  number       String
  level        String?
  hasEvCharger Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  community Community  @relation(fields: [communityId], references: [id])
  building  Building?  @relation(fields: [buildingId], references: [id])
  apartment Apartment? @relation(fields: [apartmentId], references: [id])
  reports   Report[]

  @@unique([communityId, number])
  @@index([apartmentId])
}

model StorageUnit {
  id          String   @id @default(cuid())
  communityId String
  buildingId  String
  apartmentId String?
  number      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community  @relation(fields: [communityId], references: [id])
  building  Building   @relation(fields: [buildingId], references: [id])
  apartment Apartment? @relation(fields: [apartmentId], references: [id])
  reports   Report[]

  @@unique([buildingId, number])
  @@index([apartmentId])
}

model Report {
  id             String           @id @default(cuid())
  communityId    String
  buildingId     String?
  apartmentId    String?
  parkingSpaceId String?
  storageUnitId  String?
  authorId       String
  category       String
  type           ReportType
  visibility     ReportVisibility
  title          String
  description    String
  status         ReportStatus     @default(NEW)
  urgent         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  resolvedAt     DateTime?

  community    Community     @relation(fields: [communityId], references: [id])
  building     Building?     @relation(fields: [buildingId], references: [id])
  apartment    Apartment?    @relation(fields: [apartmentId], references: [id])
  parkingSpace ParkingSpace? @relation(fields: [parkingSpaceId], references: [id])
  storageUnit  StorageUnit?  @relation(fields: [storageUnitId], references: [id])
  author       User          @relation(fields: [authorId], references: [id])

  reactions Reaction[]
  comments  Comment[]

  @@index([communityId, visibility, status])
  @@index([authorId])
}

model AuditLog {
  id          String   @id @default(cuid())
  communityId String
  userId      String?
  action      String
  entity      String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([communityId, createdAt])
  @@index([entity, entityId])
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id              String    @id @default(cuid())
  communityId     String
  recipientUserId String
  type            String
  payload         Json
  dedupeKey       String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  community  Community              @relation(fields: [communityId], references: [id])
  recipient  User                   @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  deliveries NotificationDelivery[]

  @@unique([recipientUserId, dedupeKey])
  @@index([recipientUserId, readAt, createdAt])
  @@index([communityId])
}

model NotificationDelivery {
  id             String         @id @default(cuid())
  notificationId String
  channel        String
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  lastError      String?
  sentAt         DateTime?
  nextAttemptAt  DateTime?
  createdAt      DateTime       @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
}

model NotificationPreference {
  userId       String   @id
  emailEnabled Boolean  @default(false)
  smsEnabled   Boolean  @default(false)
  phone        String?
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ResidencyKind {
  OWNER
  TENANT
}

model ApartmentResidency {
  id                String        @id @default(cuid())
  userId            String
  apartmentId       String
  communityId       String
  kind              ResidencyKind
  livesHereOverride Boolean?
  receivesPackages  Boolean       @default(true)
  isPrimary         Boolean       @default(false)
  createdAt         DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id])
  apartment Apartment @relation(fields: [apartmentId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([userId, apartmentId])
  @@index([userId])
  @@index([apartmentId])
}

enum InfoSectionKind {
  CONTACTS
  TEXT
}

model InfoSection {
  id          String          @id @default(cuid())
  communityId String
  title       String
  kind        InfoSectionKind
  body        String          @default("")
  position    Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  community Community     @relation(fields: [communityId], references: [id])
  contacts  InfoContact[]

  @@index([communityId, position])
}

model InfoContact {
  id        String  @id @default(cuid())
  sectionId String
  name      String
  phone     String
  note      String?
  position  Int

  section InfoSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
}

enum ReactionKind {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  postId    String?
  reportId  String?
  kind      ReactionKind
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, reportId])
  @@index([postId])
  @@index([reportId])
}

model Comment {
  id        String    @id @default(cuid())
  authorId  String
  postId    String?
  reportId  String?
  parentId  String?
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post    Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  report  Report?   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([reportId, createdAt])
  @@index([parentId])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model JoinRequest {
  id           String            @id @default(cuid())
  userId       String
  communityId  String
  buildingId   String
  apartmentId  String
  kind         ResidencyKind
  note         String?
  status       JoinRequestStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  rejectReason String?
  createdAt    DateTime          @default(now())

  user      User      @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation("JoinRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  community Community @relation(fields: [communityId], references: [id])
  building  Building  @relation(fields: [buildingId], references: [id])
  apartment Apartment @relation(fields: [apartmentId], references: [id])

  @@index([communityId, status, createdAt])
  @@index([userId])
}
